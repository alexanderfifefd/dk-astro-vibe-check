---
/**
 * Standalone newsletter signup component.
 * Can be used full-width (with heading/description) or compact (inline form only).
 */
interface Props {
  /** Compact layout — smaller padding, inline style. Use in footers, cards. */
  compact?: boolean;
  /** Show heading and optional description. Use for dedicated newsletter sections. */
  heading?: string;
  description?: string;
}

const {
  compact = false,
  heading,
  description,
} = Astro.props;
---

<div class:list={[!compact && "space-y-4"]}>
  {heading && (
    <div class="mb-4">
      <h3 class="text-lg font-semibold text-text">{heading}</h3>
      {description && (
        <p class="mt-1 text-sm text-text-muted">{description}</p>
      )}
    </div>
  )}
  <form class="flex gap-2" onsubmit="return false;">
    <input
      type="email"
      placeholder="din@epost.no"
      class:list={[
        "flex-1 bg-base border border-border rounded px-3 text-sm text-text placeholder:text-text-muted/50 focus:outline-none focus:border-accent transition-colors",
        compact ? "py-2" : "py-2.5",
      ]}
    />
    <button
      type="submit"
      class:list={[
        "bg-accent text-base font-medium rounded hover:bg-accent-hover transition-colors shrink-0 text-sm",
        compact ? "px-3 py-2" : "px-4 py-2.5",
      ]}
    >
      Meld meg på
    </button>
  </form>
</div>

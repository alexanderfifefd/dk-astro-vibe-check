---
import Button from './Button.astro';

interface Props {
  title: string;
  tagline?: string;
  items?: string[];
  href?: string;
  ctaLabel?: string;
  highlighted?: boolean;
}

const { title, tagline, items = [], href, ctaLabel, highlighted = false } = Astro.props;
---

<div class:list={[
  "flex flex-col p-8 rounded-lg transition-colors",
  highlighted
    ? "bg-surface border-2 border-accent/30"
    : "bg-surface border border-border hover:border-border-strong",
]}>
  <h3 class="text-xl font-semibold mb-1">{title}</h3>
  {tagline && (
    <p class="text-text-muted text-sm italic mb-4">{tagline}</p>
  )}

  {items.length > 0 && (
    <ul class="space-y-2 mb-6 flex-1 list-none">
      {items.map((item) => (
        <li class="flex items-start gap-2 text-sm text-text-muted">
          <span class="w-1.5 h-1.5 rounded-full bg-accent mt-1.5 shrink-0" aria-hidden="true" />
          <span>{item}</span>
        </li>
      ))}
    </ul>
  )}

  <slot />

  {href && ctaLabel && (
    <div class="mt-auto flex justify-end">
      <Button
        href={href}
        variant={highlighted ? "primary" : "secondary"}
        size="sm"
      >
        {ctaLabel}
      </Button>
    </div>
  )}
</div>
